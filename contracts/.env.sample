# Base Mainnet (fill in for mainnet deployment)
PRIVATE_KEY_BASE=
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia (fill in for testnet deployment)
PRIVATE_KEY_BASE_SEPOLIA=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Local Anvil (these are the well-known default anvil keys — safe for local dev only!)
PRIVATE_KEY_ANVIL=YOUR_LOCAL_ANVIL_PRIVATE_KEY
ANVIL_RPC_URL=http://127.0.0.1:8545
SEED_PHRASE=test test test test test test test test test test test junk

# Existing NinjaIncoGame address used when deploying attributes or duel contracts
NINJAINCO_REGISTRY_ADDRESS=

# Existing NinjaIncoDuel address used when deploying promotion
NINJAINCO_DUEL_ADDRESS=
